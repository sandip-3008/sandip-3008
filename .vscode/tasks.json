{
  "version": "2.0.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Run My Project",
      "console": "integratedTerminal",
      "program": "${workspaceFolder}/index.js"      
    }
  ],
  "tasks": [
    {
      "label": "eslint-check",
      "type": "shell",
      "command": "npx eslint .",
      "problemMatcher": ["$eslint-stylish"],
      "isBackground": false,
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false,
        "clear": true,
        "echo": true
      }
    },
  ]
}
